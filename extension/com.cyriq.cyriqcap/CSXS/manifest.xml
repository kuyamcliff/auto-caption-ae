<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.cyriq.cyriqcap" ExtensionBundleVersion="1.0.0" ExtensionBundleName="CyriqCap"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.cyriq.cyriqcap.panel" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- After Effects 2019 (16.0) and every later version -->
      <Host Name="AEFT" Version="[16.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.cyriq.cyriqcap.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>CyriqCap</Menu>
          <Geometry>
            <Size><Height>820</Height><Width>440</Width></Size>
            <MinSize><Height>360</Height><Width>280</Width></MinSize>
            <MaxSize><Height>3000</Height><Width>3000</Width></MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./img/icon-dark.png</Icon>
            <Icon Type="RollOver">./img/icon-dark.png</Icon>
            <Icon Type="DarkNormal">./img/icon-dark.png</Icon>
            <Icon Type="DarkRollOver">./img/icon-dark.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
